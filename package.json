{
  "name": "periapsis-zero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node -e \"require('fs').rmSync('node_modules/.vite', { recursive: true, force: true })\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "textures:preview": "node scripts/preview-textures.mjs",
    "textures:fetch": "node scripts/fetch-hd-textures.js",
    "models:scan": "node scripts/scan-models.mjs",
    "icons": "node scripts/make-favicon.mjs",
    "verify:icons": "node scripts/verify-icons.mjs",
    "verify:surround": "node scripts/verify-surround.mjs",
    "verify:cosmos": "node scripts/verify-cosmos.mjs",
    "hulls:measure": "node scripts/measure-hulls.mjs",
    "moon:measure": "node scripts/measure-moon.mjs",
    "models:extract": "node scripts/extract-archives.mjs",
    "fly": "node scripts/flight.mjs",
    "verify:anomalies": "node scripts/verify-anomalies.mjs",
    "verify:warp": "node scripts/verify-warp.mjs",
    "verify:return": "node scripts/verify-return.mjs",
    "verify:tei": "node scripts/verify-tei-timing.mjs",
    "verify:loi": "node scripts/verify-loi.mjs",
    "verify:staging": "node scripts/verify-staging.mjs",
    "verify:lunar-ascent": "node --expose-gc scripts/verify-lunar-ascent.mjs",
    "verify:heating": "node scripts/verify-heating.mjs",
    "verify:guidance": "node scripts/verify-entry-guidance.mjs",
    "verify:approach": "node scripts/verify-approach.mjs",
    "verify:nrho": "node --expose-gc scripts/verify-nrho-cycle.mjs",
    "verify:cr3bp": "node scripts/verify-cr3bp.mjs",
    "verify:family": "node scripts/verify-nrho-family.mjs",
    "verify:ephemeris": "node scripts/verify-nrho-ephemeris.mjs",
    "verify:keeping": "node scripts/verify-nrho-keeping.mjs",
    "verify:capture": "node --expose-gc scripts/verify-nrho-capture.mjs",
    "verify:director": "node --expose-gc scripts/verify-director.mjs",
    "verify:geometry": "node scripts/verify-geometry.mjs",
    "verify:vessels": "node scripts/verify-vessels.mjs",
    "verify:sites": "node scripts/verify-launch-sites.mjs",
    "verify:prem": "node --expose-gc scripts/verify-prem.mjs",
    "verify:loiter": "node scripts/verify-loiter.mjs",
    "verify:radial": "node scripts/verify-radial.mjs",
    "verify:predict": "node --expose-gc scripts/verify-predict.mjs",
    "verify:nodes": "node --expose-gc scripts/verify-nodes.mjs",
    "verify:gizmo": "node --expose-gc scripts/verify-gizmo.mjs",
    "verify:horizon": "node --expose-gc scripts/verify-horizon.mjs",
    "verify:frames": "node --expose-gc scripts/verify-frames.mjs",
    "verify:navigation": "node --expose-gc scripts/verify-navigation.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "record:attitude": "node scripts/record-attitude.mjs",
    "verify:camera": "node scripts/verify-camera-filter.mjs",
    "verify:alloc": "node --expose-gc scripts/verify-allocation.mjs",
    "verify:rails": "node --expose-gc scripts/verify-rails.mjs",
    "terrain:fetch": "node scripts/fetch-terrain.mjs",
    "verify:terrain": "node scripts/verify-terrain.mjs",
    "verify:solar": "node scripts/verify-solar.mjs",
    "stars:fetch": "node scripts/fetch-stars.mjs",
    "verify:stars": "node scripts/verify-stars.mjs",
    "verify:shadows": "node --expose-gc scripts/verify-shadows.mjs",
    "verify:plume": "node --expose-gc scripts/verify-plume.mjs",
    "verify:plasma": "node --expose-gc scripts/verify-plasma.mjs",
    "verify:pads": "node --expose-gc scripts/verify-pads.mjs && node scripts/verify-pad-geometry.mjs",
    "verify:audio": "node --expose-gc scripts/verify-audio.mjs",
    "fixture:lunar": "node scripts/flight.mjs --until LUNAR_ORBIT --save scripts/fixtures/lunar-orbit.json",
    "fixture:approach": "node scripts/flight.mjs --until LUNAR_APPROACH --save scripts/fixtures/lunar-approach.json",
    "fixture:approach:artemis": "PERIAPSIS_VESSEL=artemis node scripts/flight.mjs --until LUNAR_APPROACH --save scripts/fixtures/lunar-approach-artemis.json",
    "verify:csm": "node scripts/verify-csm.mjs",
    "verify:j3": "node scripts/verify-j3.mjs",
    "verify:countdown": "node --expose-gc scripts/verify-countdown.mjs",
    "verify:ground": "node --expose-gc scripts/verify-ground-view.mjs",
    "verify:moon": "node --expose-gc scripts/verify-moon-frame.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.0.0",
    "postprocessing": "^6.36.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "7zip-bin": "^5.2.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.0"
  }
}
