# Godot-specific ignores
.godot/
*.translation
# Copied in from public/ by scripts/godot-sync.mjs; the originals are the source.
assets/
# Texture .import files next to the GLBs are written by Godot and set per
# build target by scripts/godot-build.mjs.
art/*.png.import
art/*.jpg.import
art/*.png
art/*.jpg
# The subdivided people for the desktop build: rebuilt by art/godot/people.py --hd
art/person-*_hd.glb
art/person-*_hd.glb.import
