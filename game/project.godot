; Engine configuration file.
; Periapsis Zero, desktop edition. Forward+ on desktop; the web export
; falls back to the Compatibility renderer automatically.

config_version=5

[application]

config/name="Periapsis Zero"
config/description="Dogfights where the orbits are real."
run/main_scene="res://scenes/title.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Flow="*res://scripts/core/flow.gd"
Sfx="*res://scripts/core/sfx.gd"
Hud="*res://scripts/ui/hud.gd"
Shot="*res://scripts/tools/shot.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
textures/default_filters/anisotropic_filtering_level=4

